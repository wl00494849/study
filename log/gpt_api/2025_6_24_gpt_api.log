import numpy as np
import re

def extract_postcode(address):
    m = re.search(r'(\d{3,5})', str(address))
    return m.group(1) if m else np.nan

def extract_area(address):
    area_list = ['雲林縣', '高雄市', '南投縣']
    for area in area_list:
        if area in str(address):
            return area
    return np.nan

df1_ = df1.rename(columns={'主管機關':'authority','地區':'area','熱點名稱':'site_name','地址':'address','經度':'longitude','緯度':'latitude'})
df1_['post_code'] = df1_['address'].map(extract_postcode)

df2_ = df2.rename(columns={'地點':'site_name','地址':'address','Longitude':'longitude','Latitude':'latitude'})
df2_['area'] = df2_['address'].map(extract_area)
df2_['post_code'] = df2_['address'].map(extract_postcode)

df3_ = df3.rename(columns={'主管機關（所屬機關名稱）':'authority','地區（所屬縣市名稱）':'area','熱點名稱（依熱點所在地命名）':'site_name','郵地區號':'post_code','地址':'address','經度':'longitude','緯度':'latitude'})
df3_['post_code'] = df3_['post_code'].astype(str).str.zfill(3)

df1_['post_code'] = df1_['post_code'].astype(str).str.zfill(3).replace({'nan':np.nan})
df2_['post_code'] = df2_['post_code'].astype(str).str.zfill(3).replace({'nan':np.nan})

df1_sel = df1_[['post_code','area','site_name','address','longitude','latitude']]
df2_sel = df2_[['post_code','area','site_name','address','longitude','latitude']]
df3_sel = df3_[['post_code','area','site_name','address','longitude','latitude']]

result = pd.concat([df1_sel,df2_sel,df3_sel],ignore_index=True)

result['post_code'] = result['post_code'].replace('nan',np.nan)
result['post_code'] = result['post_code'].where(result['post_code'].notna(), None)

def post_code_key(x):
    try:
        return int(x)
    except:
        return 999999

result = result.sort_values(by='post_code', key=lambda x: x.map(post_code_key)).reset_index(drop=True)
