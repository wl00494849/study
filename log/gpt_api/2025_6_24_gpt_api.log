df1_proc = df1.copy()
df1_proc['郵遞區號'] = df1_proc['地址'].str.extract(r'(\d{3,5})').astype('Int64')
df1_proc = df1_proc.rename(columns={'地區':'地區','熱點名稱':'熱點名稱','地址':'地址','經度':'經度','緯度':'緯度'})
df1_proc = df1_proc[['郵遞區號','地區','熱點名稱','地址','經度','緯度']]

df2_proc = df2.rename(columns={'地點':'熱點名稱','Latitude':'緯度','Longitude':'經度'})
df2_proc['郵遞區號'] = df2_proc['地址'].str.extract(r'(\d{3,5})').astype('Int64')
df2_proc['地區'] = df2_proc['地址'].str.extract(r'([^\d]{2,3}市)').fillna('')
df2_proc = df2_proc[['郵遞區號','地區','熱點名稱','地址','經度','緯度']]

df3_proc = df3.rename(columns={
    '地區（所屬縣市名稱）':'地區',
    '熱點名稱（依熱點所在地命名）':'熱點名稱',
    '郵地區號':'郵遞區號',
    '經度':'經度',
    '緯度':'緯度',
    '地址':'地址'
})
df3_proc = df3_proc[['郵遞區號','地區','熱點名稱','地址','經度','緯度']]
df3_proc['郵遞區號'] = df3_proc['郵遞區號'].astype('Int64')

result = pd.concat([df1_proc, df2_proc, df3_proc], ignore_index=True)
result['郵遞區號'] = pd.to_numeric(result['郵遞區號'], errors='coerce').astype('Int64')
result['經度'] = pd.to_numeric(result['經度'], errors='coerce')
result['緯度'] = pd.to_numeric(result['緯度'], errors='coerce')
result['地區'] = result['地區'].fillna('')
result['熱點名稱'] = result['熱點名稱'].fillna('')
result['地址'] = result['地址'].fillna('')

result = result.sort_values(by='郵遞區號', na_position='last').reset_index(drop=True)
