import re

def extract_zipcode(address):
    m = re.match(r'(\d{3,5})', address)
    return m.group(1) if m else None

df1['郵遞區號'] = df1['地址'].apply(extract_zipcode)
df1_rename = df1.rename(columns={'地區':'地區', '熱點名稱':'熱點名稱', '地址':'地址', '經度':'經度', '緯度':'緯度'})
df1_sel = df1_rename[['郵遞區號','地區','熱點名稱','地址','經度','緯度']]

df2['郵遞區號'] = df2['地址'].apply(extract_zipcode)
df2['地區'] = None
df2_rename = df2.rename(columns={'地點':'熱點名稱', '地址':'地址', 'Longitude':'經度', 'Latitude':'緯度'})
df2_sel = df2_rename[['郵遞區號','地區','熱點名稱','地址','經度','緯度']]

df3_rename = df3.rename(columns={
    '主管機關（所屬機關名稱）':'主管機關',
    '地區（所屬縣市名稱）':'地區',
    '熱點名稱（依熱點所在地命名）':'熱點名稱',
    '郵地區號':'郵遞區號',
    '地址':'地址',
    '經度':'經度',
    '緯度':'緯度'
})
df3_sel = df3_rename[['郵遞區號','地區','熱點名稱','地址','經度','緯度']]

result = pd.concat([df1_sel, df2_sel, df3_sel], ignore_index=True)
result['郵遞區號'] = pd.to_numeric(result['郵遞區號'], errors='coerce')
result = result.sort_values(by='郵遞區號', na_position='last').reset_index(drop=True)
