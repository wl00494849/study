def get_avg_sum(df, stock_id):
    df1 = df.iloc[:, [1,2,3]].copy()
    df1.columns = ['券商', '價格', '買進股數']
    mask = (df1['價格'].notnull()) & (df1['買進股數'] > 0)
    df1 = df1[mask]
    df1['加權價格'] = df1['價格'] * df1['買進股數']
    df_grouped = df1.groupby('券商').agg({'加權價格':'sum', '買進股數':'sum'})
    df_grouped['均價'] = (df_grouped['加權價格']/df_grouped['買進股數']).round(1)
    df_grouped[stock_id] = stock_id
    return df_grouped.reset_index()[['券商', '均價', '買進股數', stock_id]]

r1 = get_avg_sum(df1, '2454')
r2 = get_avg_sum(df2, '2454')
result = pd.concat([r1, r2]).groupby(['券商', '2454'], as_index=False).agg({'均價':'mean', '買進股數':'sum'})
result['均價'] = result['均價'].round(1)
