stock_id = df1.fileName.split("聯發科")[1].split("_")[0]
def reshape(df):
    left = df.loc[:, ['券商', '價格', '買進股數']].rename(columns={'券商':'券商', '價格':'價格', '買進股數':'買進股數'})
    right = df.loc[:, ['券商.1', '價格.1', '買進股數.1']].rename(columns={'券商.1':'券商', '價格.1':'價格', '買進股數.1':'買進股數'})
    return pd.concat([left, right], ignore_index=True).dropna(subset=['券商'])

df1_long = reshape(df1)
