    '總買進股數': x['買進股數'].sum(),
    '總買進成交金額': (x['價格'] * x['買進股數']).sum()
})).reset_index()
grouped['均價'] = (grouped['總買進成交金額'] / grouped['總買進股數']).round(1)
result = grouped[['券商', '均價', '總買進股數', '總買進成交金額']].copy()
result['股票代號'] = stock_code
result = result[['券商', '均價', '總買進股數', '總買進成交金額', '股票代號']]
