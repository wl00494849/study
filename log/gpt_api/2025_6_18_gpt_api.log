def preprocess(df):
    left = df[['券商','價格','買進股數']].copy()
    right = df[['券商.1','價格.1','買進股數.1']].copy()
    right.columns = ['券商','價格','買進股數']
    return pd.concat([left,right],ignore_index=True).dropna(subset=['券商','價格','買進股數'])

df1_proc = preprocess(df1)
df2_proc = preprocess(df2)

df_all = pd.concat([df1_proc,df2_proc],ignore_index=True)
df_all = df_all[df_all['買進股數']>0]

grouped = df_all.groupby('券商').apply(lambda x: pd.Series({
    '總買進股數': x['買進股數'].sum(),
    '均價': (x['價格'] * x['買進股數']).sum() / x['買進股數'].sum(),
})).reset_index()

grouped['總買進成交金額'] = grouped['均價'] * grouped['總買進股數']
grouped['均價'] = grouped['均價'].round(1)
grouped['總買進成交金額'] = grouped['總買進成交金額'].round(1)
grouped['股票代號'] = '2454'

result = grouped[['券商','均價','總買進股數','總買進成交金額','股票代號']]
```
