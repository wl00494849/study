combined_df = pd.concat([df1_filtered, df2_filtered])

total_buy = combined_df.groupby('券商').agg({'買進股數': 'sum'}).reset_index()
total_buy['總買進股數'] = total_buy['買進股數']

weighted_avg_price = combined_df.groupby('券商').apply(lambda x: (x['價格'] * x['買進股數']).sum() / x['買進股數'].sum()).reset_index(name='均價')
result = total_buy.merge(weighted_avg_price, on='券商')
result['均價'] = result['均價'].round(1)

result['股票代號'] = '2454'
result = result[['券商', '均價', '總買進股數', '股票代號']]
