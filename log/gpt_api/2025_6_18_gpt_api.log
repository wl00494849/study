Response data: exec("""
df1_left = df1[['券商','價格','買進股數']].rename(columns={'券商':'券商','價格':'價格','買進股數':'買進股數'})
df1_right = df1[['券商.1','價格.1','買進股數.1']].rename(columns={'券商.1':'券商','價格.1':'價格','買進股數.1':'買進股數'})
df2_left = df2[['券商','價格','買進股數']].rename(columns={'券商':'券商','價格':'價格','買進股數':'買進股數'})
df2_right = df2[['券商.1','價格.1','買進股數.1']].rename(columns={'券商.1':'券商','價格.1':'價格','買進股數.1':'買進股數'})
df_all = pd.concat([df1_left, df1_right, df2_left, df2_right], ignore_index=True)
df_all = df_all[df_all['券商'].notna() & (df_all['買進股數'] != 0)]
grouped = df_all.groupby('券商').apply(lambda x: pd.Series({
    '總買進股數': x['買進股數'].sum(),
    '加權均價': (x['價格'] * x['買進股數']).sum() / x['買進股數'].sum()
}))
grouped['總買進成交金額'] = grouped['總買進股數'] * grouped['加權均價']
grouped['均價'] = grouped['加權均價'].round(1)
grouped['總買進成交金額'] = grouped['總買進成交金額'].round(1)
result = grouped.reset_index()[['券商','均價','總買進股數','總買進成交金額']]
result['股票代號'] = '2454'
result = result[['券商','均價','總買進股數','總買進成交金額','股票代號']]
""")
