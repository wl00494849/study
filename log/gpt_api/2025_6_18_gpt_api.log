df1['股票代號'] = '聯發科2454'
df2['股票代號'] = '聯發科2454'
df_combined = pd.concat([df1[['券商', '價格', '買進股數', '股票代號']], df2[['券商', '價格', '買進股數', '股票代號']]], ignore_index=True)
