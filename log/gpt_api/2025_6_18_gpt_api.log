Response data: ```python
df1_a = df1[['券商', '價格', '買進股數']].copy()
df1_b = df1[['券商.1', '價格.1', '買進股數.1']].copy()
df1_b.columns = ['券商', '價格', '買進股數']
df2_a = df2[['券商', '價格', '買進股數']].copy()
df2_b = df2[['券商.1', '價格.1', '買進股數.1']].copy()
df2_b.columns = ['券商', '價格', '買進股數']
long_df = pd.concat([df1_a, df1_b, df2_a, df2_b], ignore_index=True)
long_df = long_df.dropna(subset=['券商', '價格', '買進股數'])
long_df = long_df[long_df['買進股數'] > 0]
grp = long_df.groupby('券商', as_index=False)
agg = grp.agg({'價格':'sum', '買進股數':'sum'})
agg['加權均價'] = grp.apply(lambda x: round((x['價格']*x['買進股數']).sum()/x['買進股數'].sum(),1)).values
agg = agg[['券商', '加權均價', '買進股數']]
agg.rename(columns={'買進股數':'總買進股數'}, inplace=True)
agg.insert(0, '股票代號', '2454')
result = agg.reset_index(drop=True)
