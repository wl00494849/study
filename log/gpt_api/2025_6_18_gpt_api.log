df1_cleaned = df1[['券商', '價格', '買進股數']].dropna()
df2_cleaned = df2[['券商', '價格', '買進股數']].dropna()
df1_grouped = df1_cleaned.groupby('券商').agg({'價格': 'mean', '買進股數': 'sum'}).reset_index()
df2_grouped = df2_cleaned.groupby('券商').agg({'價格': 'mean', '買進股數': 'sum'}).reset_index()
result = pd.merge(df1_grouped, df2_grouped, on='券商', suffixes=('_1', '_2'))
result['均價'] = ((result['價格_1'] * result['買進股數_1']) + (result['價格_2'] * result['買進股數_2'])) / (result['買進股數_1'] + result['買進股數_2'])
result['均價'] = result['均價'].round(1)
result['總買進股數'] = result['買進股數_1'] + result['買進股數_2']
result['股票代號'] = '聯發科2454'
result = result[['券商', '均價', '總買進股數', '股票代號']]
```
