def extract_stock_code(filename):
    import re
    m = re.search(r'(\d{4})_', filename)
    return m.group(1) if m else ''

stock_code1 = extract_stock_code('聯發科2454_20250528.csv')
stock_code2 = extract_stock_code('聯發科2454_20250529.csv')

df1_first = df1.loc[df1['買進股數']>0, ['券商','價格','買進股數']]
df1_second = df1.loc[df1['買進股數.1']>0, ['券商.1','價格.1','買進股數.1']].rename(columns={'券商.1':'券商','價格.1':'價格','買進股數.1':'買進股數'})
df1_buy = pd.concat([df1_first, df1_second], ignore_index=True)

df2_first = df2.loc[df2['買進股數']>0, ['券商','價格','買進股數']]
df2_second = df2.loc[df2['買進股數.1']>0, ['券商.1','價格.1','買進股數.1']].rename(columns={'券商.1':'券商','價格.1':'價格','買進股數.1':'買進股數'})
df2_buy = pd.concat([df2_first, df2_second], ignore_index=True)

df_all = pd.concat([df1_buy, df2_buy], ignore_index=True)

grouped = df_all.groupby('券商', dropna=True).agg(
    總買進股數 = ('買進股數','sum'),
    總買進成交金額 = ('買進股數', lambda x: (df_all.loc[x.index,'價格'] * x).sum())
).reset_index()

grouped['均價'] = (grouped['總買進成交金額'] / grouped['總買進股數']).round(1)

grouped['股票代號'] = stock_code1 if stock_code1 == stock_code2 else stock_code1 + ',' + stock_code2

result = grouped[['券商','均價','總買進股數','總買進成交金額','股票代號']]
