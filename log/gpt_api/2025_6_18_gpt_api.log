df1 = df1[['券商', '價格', '買進股數']]
df2 = df2[['券商', '價格', '買進股數']]
combined = pd.concat([df1, df2])
combined['買進成交金額'] = combined['價格'] * combined['買進股數']
result = combined.groupby('券商').agg({
    '買進股數': 'sum',
    '買進成交金額': 'sum',
    '價格': 'mean'
}).reset_index()
