def process_one_df(df):
    left = df[['券商', '價格', '買進股數']].copy()
    right = df[['券商.1', '價格.1', '買進股數.1']].copy()
    right.columns = ['券商', '價格', '買進股數']
    merged = pd.concat([left, right], ignore_index=True)
    merged = merged.dropna(subset=['券商', '價格', '買進股數'])
    merged = merged[merged['買進股數'] > 0]
    return merged

df_all = pd.concat([process_one_df(df1), process_one_df(df2)], ignore_index=True)
grouped = df_all.groupby('券商').apply(
