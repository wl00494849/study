Response data: ```python
df1.rename(columns={'券商': '券商', '價格': '價格', '買進股數': '買進股數'}, inplace=True)
df1['總買進成交金額'] = df1['價格'] * df1['買進股數']
df2.rename(columns={'券商': '券商', '價格': '價格', '買進股數': '買進股數'}, inplace=True)
df2['總買進成交金額'] = df2['價格'] * df2['買進股數']
grouped_df1 = df1.groupby('券商').agg(均價=('價格', lambda x: round((x * df1.loc[x.index, '買進股數']).sum() / df1.loc[x.index, '買進股數'].sum(), 1)),
                                        總買進股數=('買進股數', 'sum'),
                                        總買進成交金額=('總買進成交金額', 'sum')).reset_index()
grouped_df2 = df2.groupby('券商').agg(均價=('價格', lambda x: round((x * df2.loc[x.index, '買進股數']).sum() / df2.loc[x.index, '買進股數'].sum(), 1)),
                                        總買進股數=('買進股數', 'sum'),
                                        總買進成交金額=('總買進成交金額', 'sum')).reset_index()
result = pd.concat([grouped_df1, grouped_df2]).groupby('券商').agg(均價=('均價', 'mean'),
                                                                 總買進股數=('總買進股數', 'sum'),
                                                                 總買進成交金額=('總買進成交金額', 'sum')).reset_index()
result['股票代號'] = 2454
result = result[['券商', '均價', '總買進股數', '總買進成交金額', '股票代號']]
result['均價'] = result['均價'].round(1)
result['總買進股數'] = result['總買進股數'].round(1)
result['總買進成交金額'] = result['總買進成交金額'].round(1)
```
