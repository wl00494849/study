df1.iloc[:, 1:] = df1.iloc[:, 1:].replace(',', '', regex=True).astype(int)
df2.iloc[:, 1:] = df2.iloc[:, 1:].astype(int)
merged = pd.merge(df1, df2, on='區名', suffixes=('_112', '_113'))
result = merged.loc[:, ['區名'] + [f'{month}' for month in ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']]]
