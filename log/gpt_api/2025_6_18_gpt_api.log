Response data: ```python
left1 = df1[['券商', '價格', '買進股數']].copy()
left1.columns = ['券商', '價格', '買進股數']
right1 = df1[['券商.1', '價格.1', '買進股數.1']].copy()
right1.columns = ['券商', '價格', '買進股數']
left2 = df2[['券商', '價格', '買進股數']].copy()
left2.columns = ['券商', '價格', '買進股數']
right2 = df2[['券商.1', '價格.1', '買進股數.1']].copy()
right2.columns = ['券商', '價格', '買進股數']
df_all = pd.concat([left1, right1, left2, right2], ignore_index=True)
df_all = df_all.dropna(subset=['券商', '價格', '買進股數'])
df_all['買進股數'] = pd.to_numeric(df_all['買進股數'], errors='coerce').fillna(0)
df_all['價格'] = pd.to_numeric(df_all['價格'], errors='coerce').fillna(0)
group = df_all.groupby('券商').agg(
    總買進股數=('買進股數', 'sum'),
    加權總價=('價格', lambda x: (x * df_all.loc[x.index, '買進股數']).sum())
)
group['均價'] = group['加權總價'] / group['總買進股數']
group['均價'] = group['均價'].round(1)
group['買進股數'] = group['總買進股數'].round(1)
result = group.reset_index()[['券商', '均價', '買進股數']]
result.insert(0, '股票代號', '2454')
```
