Response data: ```python
def exce():
    def flatten(df):
        df1 = df.iloc[:, :5].copy()
        df2 = df.iloc[:, 6:11].copy()
        df1.columns = ['序號', '券商', '價格', '買進股數', '賣出股數']
        df2.columns = ['序號', '券商', '價格', '買進股數', '賣出股數']
        df_new = pd.concat([df1, df2], ignore_index=True)
        return df_new

    all_df = pd.concat([flatten(df1), flatten(df2)], ignore_index=True)
    all_df = all_df.loc[all_df['券商'].notnull()]

    all_df = all_df[['券商', '價格', '買進股數']].copy()
    all_df = all_df.loc[all_df['買進股數'].notnull()]
    all_df['買進股數'] = all_df['買進股數'].astype(float)
    all_df['價格'] = all_df['價格'].astype(float)
    all_df = all_df[all_df['買進股數'] > 0]

    grp = all_df.groupby('券商')
    result = grp.apply(
        lambda x: pd.Series({
            '均價': round((x['價格'] * x['買進股數']).sum() / x['買進股數'].sum(), 1),
            '買進總股數': x['買進股數'].sum(),
            '股票代號': '2454'
        })
    ).reset_index()

    return result
