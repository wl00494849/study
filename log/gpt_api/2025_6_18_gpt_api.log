all_flat = all_flat.dropna(subset=['券商', '價格', '買進股數'])
all_flat = all_flat[all_flat['買進股數'] > 0]

grouped = all_flat.groupby(['股票代號', '券商'])
sum_buy = grouped['買進股數'].sum()
mean_price = (grouped.apply(lambda x: (x['價格'] * x['買進股數']).sum() / x['買進股數'].sum())).round(1)
result = pd.DataFrame({'股票代號': sum_buy.index.get_level_values(0),
                       '券商': sum_buy.index.get_level_values(1),
                       '均價': mean_price.values,
                       '總買進股數': sum_buy.values})
result = result[['股票代號', '券商', '均價', '總買進股數']].sort_values('總買進股數', ascending=False).reset_index(drop=True)
