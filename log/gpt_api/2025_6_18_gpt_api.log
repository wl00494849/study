def get_buy_data(df):
    df_buy1 = df[['券商','價格','買進股數']].rename(columns={'券商':'券商','價格':'價格','買進股數':'買進股數'})
    df_buy2 = df[['券商.1','價格.1','買進股數.1']].rename(columns={'券商.1':'券商','價格.1':'價格','買進股數.1':'買進股數'})
    df_all = pd.concat([df_buy1, df_buy2], ignore_index=True)
    df_all = df_all.dropna(subset=['券商','價格','買進股數'])
    df_all['價格'] = pd.to_numeric(df_all['價格'], errors='coerce')
    df_all['買進股數'] = pd.to_numeric(df_all['買進股數'], errors='coerce')
    df_all = df_all.dropna(subset=['價格','買進股數'])
    df_all = df_all[df_all['買進股數']>0]
    df_all['券商'] = df_all['券商'].str.strip()
    return df_all

df1_buy = get_buy_data(df1)
df2_buy = get_buy_data(df2)

df_all = pd.concat([df1_buy, df2_buy], ignore_index=True)

grouped = df_all.groupby('券商').agg(
    總買進股數=('買進股數','sum'),
    總買進成交金額=('買進股數',lambda x: (df_all.loc[x.index, '價格'] * x).sum())
)
grouped['均價'] = (grouped['總買進成交金額'] / grouped['總買進股數']).round(1)
grouped = grouped.reset_index()
grouped['股票代號'] = '2454'
result = grouped[['券商','均價','總買進股數','總買進成交金額','股票代號']]
