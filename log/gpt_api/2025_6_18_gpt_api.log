df1_front = df1.loc[:, ['券商', '價格', '買進股數']]
df1_back = df1.loc[:, ['券商.1', '價格.1', '買進股數.1']]
df1_back.columns = ['券商', '價格', '買進股數']
df1_long = pd.concat([df1_front, df1_back], axis=0, ignore_index=True)

df2_front = df2.loc[:, ['券商', '價格', '買進股數']]
df2_back = df2.loc[:, ['券商.1', '價格.1', '買進股數.1']]
df2_back.columns = ['券商', '價格', '買進股數']
df2_long = pd.concat([df2_front, df2_back], axis=0, ignore_index=True)

all_data = pd.concat([df1_long, df2_long], axis=0, ignore_index=True)
all_data = all_data[all_data['買進股數'] > 0]

grouped = all_data.groupby('券商').apply(lambda g: pd.Series({
    '均價': (g['價格'] * g['買進股數']).sum() / g['買進股數'].sum(),
    '總買進股數': g['買進股數'].sum()
}))

grouped['均價'] = grouped['均價'].round(1)
grouped['股票代號'] = '2454'
result = grouped.reset_index()
