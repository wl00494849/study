def extract_data(df):
    df_left = df.loc[:, ['券商', '價格', '買進股數']].rename(columns={'券商':'券商', '價格':'價格', '買進股數':'買進股數'})
    df_right = df.loc[:, ['券商.1', '價格.1', '買進股數.1']].rename(columns={'券商.1':'券商', '價格.1':'價格', '買進股數.1':'買進股數'})
    df_concat = pd.concat([df_left, df_right], ignore_index=True)
    df_concat['券商'] = df_concat['券商'].str.replace('\u3000', '', regex=False)
    return df_concat.dropna(subset=['券商','價格','買進股數'])

df1_expanded = extract_data(df1)
df2_expanded = extract_data(df2)
df_merge = pd.concat([df1_expanded, df2_expanded], ignore_index=True)
