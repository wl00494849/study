    result[month] = ((merged[f'{month}_112'] + merged[f'{month}_113']) / 2).astype(int)
result = result.rename(columns={month: month for month in ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']})
