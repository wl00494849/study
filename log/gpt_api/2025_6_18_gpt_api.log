code=()
stock_code = '2454'
def split_df(df):
    df1 = df.iloc[:, :5].copy()
    df1.columns = ['序號', '券商', '價格', '買進股數', '賣出股數']
    df2 = df.iloc[:, 6:11].copy()
    df2.columns = ['序號', '券商', '價格', '買進股數', '賣出股數']
    return pd.concat([df1, df2], ignore_index=True)
df_all = pd.concat([split_df(df1), split_df(df2)], ignore_index=True)
df_all = df_all.dropna(subset=['券商'])
df_all['買進股數'] = pd.to_numeric(df_all['買進股數'], errors='coerce').fillna(0)
df_all['價格'] = pd.to_numeric(df_all['價格'], errors='coerce').fillna(0)
grouped = df_all.groupby('券商').apply(lambda x: pd.Series({'總買進股數': x['買進股數'].sum(), '均價': (x['價格']*x['買進股數']).sum()/x['買進股數'].sum() if x['買進股數'].sum()!=0 else 0}))
grouped['均價'] = grouped['均價'].round(1)
result = grouped.reset_index()
result.insert(0, '股票代號', stock_code)
