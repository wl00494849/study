# 整理 df1 和 df2，以提取所需的欄位
df1_selected = df1[['券商', '價格', '買進股數']].rename(columns={'價格': '價格1', '買進股數': '買進股數1'})
df2_selected = df2[['券商', '價格', '買進股數']].rename(columns={'價格': '價格2', '買進股數': '買進股數2'})

# 合併資料
merged_data = pd.merge(df1_selected, df2_selected, on='券商', how='outer')

# 計算總買進股數與均價
merged_data['總買進股數'] = merged_data['買進股數1'].fillna(0) + merged_data['買進股數2'].fillna(0)
merged_data['均價'] = ((merged_data['價格1'].fillna(0) * merged_data['買進股數1'].fillna(0)) + 
                        (merged_data['價格2'].fillna(0) * merged_data['買進股數2'].fillna(0))) / merged_data['總買進股數']

# 整理最終結果
result = merged_data[['券商', '均價', '總買進股數']]
result['均價'] = result['均價'].round(1)
stock_id = '聯發科2454'
result['股票代號'] = stock_id
result = result[['股票代號', '券商', '均價', '總買進股數']]
