Response data: exec("""
df1_buy1 = df1[['券商', '價格', '買進股數']].rename(columns={'券商':'券商', '價格':'價格', '買進股數':'買進股數'})
df1_buy2 = df1[['券商.1', '價格.1', '買進股數.1']].rename(columns={'券商.1':'券商', '價格.1':'價格', '買進股數.1':'買進股數'})
df1_buy = pd.concat([df1_buy1, df1_buy2], ignore_index=True)
df2_buy1 = df2[['券商', '價格', '買進股數']].rename(columns={'券商':'券商', '價格':'價格', '買進股數':'買進股數'})
df2_buy2 = df2[['券商.1', '價格.1', '買進股數.1']].rename(columns={'券商.1':'券商', '價格.1':'價格', '買進股數.1':'買進股數'})
df2_buy = pd.concat([df2_buy1, df2_buy2], ignore_index=True)
all_buy = pd.concat([df1_buy, df2_buy], ignore_index=True)
all_buy = all_buy[all_buy['買進股數'].notna() & (all_buy['買進股數']>0)]
all_buy = all_buy[all_buy['價格'].notna()]
all_buy['買進股數'] = all_buy['買進股數'].astype(float)
all_buy['價格'] = all_buy['價格'].astype(float)
grouped = all_buy.groupby('券商', dropna=False).agg(總買進股數=('買進股數','sum'), 總買進成交金額=('買進股數', lambda x: (all_buy.loc[x.index, '價格']*x).sum()))
grouped['均價'] = (grouped['總買進成交金額'] / grouped['總買進股數']).round(1)
grouped = grouped.reset_index()
grouped['股票代號'] = '2454'
result = grouped[['券商', '均價', '總買進股數', '總買進成交金額', '股票代號']]
""")
