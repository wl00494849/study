def extract_stock_code(filename):
    import re
    m = re.search(r'(\d+)', filename)
    return m.group(1) if m else ''

def reshape_df(df, day):
    d1 = df[['券商', '價格', '買進股數']].copy()
    d1['day'] = day
    d2 = df[['券商.1', '價格.1', '買進股數.1']].copy()
    d2.columns = ['券商', '價格', '買進股數']
    d2['day'] = day
    return pd.concat([d1,d2], ignore_index=True)

stock_code = extract_stock_code(df1.attrs.get('fileName',''))
df1_long = reshape_df(df1, '20250528')
df2_long = reshape_df(df2, '20250529')

all_data = pd.concat([df1_long, df2_long], ignore_index=True)
all_data = all_data[all_data['買進股數'] > 0]

grouped = all_data.groupby('券商', as_index=False).apply(
    lambda x: pd.Series({
        '均價': round((x['價格'] * x['買進股數']).sum() / x['買進股數'].sum(), 1),
        '買進股數': x['買進股數'].sum()
    })
).reset_index()

result = grouped[['券商', '均價', '買進股數']]
result['股票代號'] = stock_code
