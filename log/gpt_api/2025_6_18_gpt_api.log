result_vals = ((combined.loc[:, [col+'_112' for col in month_cols]].values + combined.loc[:, [col+'_113' for col in month_cols]].values) / 2).round().astype(int)
result = combined.index.to_frame().reset_index(drop=True)
for i, col in enumerate(month_cols):
    result[col] = result_vals[:, i]
result = result[['區名'] + month_cols]
