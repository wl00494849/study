all_df = all_df[all_df['買進股數'] > 0]
all_df['成交金額'] = all_df['價格'] * all_df['買進股數']
grouped = all_df.groupby('券商', as_index=False).agg({'買進股數':'sum', '成交金額':'sum'})
grouped['均價'] = (grouped['成交金額'] / grouped['買進股數']).round(1)
grouped['股票代號'] = '2454'
result = grouped[['券商', '股票代號', '均價', '買進股數']]
```
