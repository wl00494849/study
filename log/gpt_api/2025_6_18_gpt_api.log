grp['均價'] = (grp['成交金額'] / grp['買進股數']).fillna(0).round(1)
grp.rename(columns={'買進股數':'總買進股數','成交金額':'總買進成交金額'}, inplace=True)
result = grp[['券商','均價','總買進股數','總買進成交金額']].copy()
result['股票代號'] = stock_code
