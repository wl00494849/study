stock_code = "聯發科2454"
df1_filtered = df1[['券商', '價格', '買進股數']].rename(columns={'買進股數': '買進股數_1', '價格': '價格_1'})
df2_filtered = df2[['券商', '價格', '買進股數']].rename(columns={'買進股數': '買進股數_2', '價格': '價格_2'})
