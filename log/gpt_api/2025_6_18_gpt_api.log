df1_main = df1[['券商', '價格', '買進股數']]
df1_sec = df1[['券商.1', '價格.1', '買進股數.1']].rename(columns={'券商.1': '券商', '價格.1': '價格', '買進股數.1': '買進股數'})
df2_main = df2[['券商', '價格', '買進股數']]
df2_sec = df2[['券商.1', '價格.1', '買進股數.1']].rename(columns={'券商.1': '券商', '價格.1': '價格', '買進股數.1': '買進股數'})
