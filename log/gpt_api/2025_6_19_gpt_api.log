df1_months = df1.columns[1:]
for col in df1_months:
    df1[col] = df1[col].str.replace(',', '').astype(int)
common_areas = df1['區名'].isin(df2['區名'])
df1_aligned = df1[common_areas].reset_index(drop=True)
df2_aligned = df2[df2['區名'].isin(df1_aligned['區名'])].reset_index(drop=True)
df1_aligned = df1_aligned.sort_values('區名').reset_index(drop=True)
df2_aligned = df2_aligned.sort_values('區名').reset_index(drop=True)
result = df1_aligned.copy()
for col in df1_months:
    avg_values = ((df1_aligned[col] + df2_aligned[col]) / 2).round().astype(int)
    result[col] = avg_values
