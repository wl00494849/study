def clean_broker(name):
    if isinstance(name, str):
        return name.replace('\u3000', '').strip()
    return name

def extract(df):
    df_a = df[['券商','價格','買進股數']].copy()
    df_b = df[['券商.1','價格.1','買進股數.1']].copy()
    df_a.columns = ['券商','價格','買進股數']
    df_b.columns = ['券商','價格','買進股數']
    combined = pd.concat([df_a, df_b], ignore_index=True)
    combined = combined.dropna(subset=['券商', '價格', '買進股數'])
    combined['券商'] = combined['券商'].apply(clean_broker)
    combined['價格'] = pd.to_numeric(combined['價格'], errors='coerce')
    combined['買進股數'] = pd.to_numeric(combined['買進股數'], errors='coerce')
    combined = combined.dropna(subset=['價格', '買進股數'])
    return combined

df_all = pd.concat([extract(df1), extract(df2)], ignore_index=True)
df_all['成交金額'] = df_all['價格'] * df_all['買進股數']
grouped = df_all.groupby('券商', as_index=False).agg({'買進股數':'sum', '成交金額':'sum'})
grouped['購買均價'] = (grouped['成交金額'] / grouped['買進股數']).round(1)
grouped['股票代號'] = '2454'
result = grouped[['股票代號','券商','買進股數','成交金額','購買均價']]
```
