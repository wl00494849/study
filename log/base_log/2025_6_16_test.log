total_grouped['總買進股數'] = total_grouped['買進股數_df1'] + total_grouped['買進股數_df2']
total_grouped['總成交金額'] = total_grouped['成交金額_df1'] + total_grouped['成交金額_df2']
total_grouped['購買均價'] = total_grouped['總成交金額'] / total_grouped['總買進股數']
total_grouped['購買均價'] = total_grouped['購買均價'].round(1)

result = total_grouped[['券商', '總買進股數', '總成交金額', '購買均價']]
result['股票代號'] = '2454'
