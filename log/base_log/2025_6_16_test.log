df1[['券商', '買進股數', '價格']].rename(columns={'買進股數': '買進股數', '價格': '價格'}).assign 股票代號='2454'
df2[['券商', '買進股數.1', '價格.1']].rename(columns={'買進股數.1': '買進股數', '價格.1': '價格'}).assign 股票代號='2454'
