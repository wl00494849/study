df1_clean = df1.dropna(subset=['價格', '買進股數'])
df2_clean = df2.dropna(subset=['價格', '買進股數'])

df1_grouped = df1_clean.groupby('券商').agg({'價格': lambda x: round((x * df1_clean.loc[x.index, '買進股數']).sum() / df1_clean.loc[x.index, '買進股數'].sum(), 1),
                                               '買進股數': 'sum'}).reset_index()
df2_grouped = df2_clean.groupby('券商').agg({'價格': lambda x: round((x * df2_clean.loc[x.index, '買進股數']).sum() / df2_clean.loc[x.index, '買進股數'].sum(), 1),
                                               '買進股數': 'sum'}).reset_index()

df1_grouped.rename(columns={'券商': '券商', '價格': '均價', '買進股數': '總買進股數'}, inplace=True)
df2_grouped.rename(columns={'券商': '券商', '價格': '均價', '買進股數': '總買進股數'}, inplace=True)

result = pd.merge(df1_grouped, df2_grouped, on='券商', suffixes=('_1', '_2'))
result['總買進價格_1'] = result['均價_1'] * result['總買進股數_1']
result['總買進價格_2'] = result['均價_2'] * result['總買進股數_2']
