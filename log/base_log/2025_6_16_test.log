df1.drop(columns=['Unnamed: 5'], inplace=True)
df2.drop(columns=['Unnamed: 5'], inplace=True)
df1_melted = df1.melt(id_vars=['券商'], value_vars=['買進股數', '價格'], var_name='交易種類', value_name='數值')
df2_melted = df2.melt(id_vars=['券商'], value_vars=['買進股數', '價格'], var_name='交易種類', value_name='數值')
