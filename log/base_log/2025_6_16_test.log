df1_cleaned = df1.drop(columns=['Unnamed: 5'])
df2_cleaned = df2.drop(columns=['Unnamed: 5'])

df1_summary = pd.concat([
    df1_cleaned.groupby('券商')['買進股數'].sum().rename('總買進股數'),
    (df1_cleaned['價格'] * df1_cleaned['買進股數']).groupby(df1_cleaned['券商']).sum().rename('總成交金額')
], axis=1).reset_index()

df2_summary = pd.concat([
    df2_cleaned.groupby('券商')['買進股數'].sum().rename('總買進股數'),
    (df2_cleaned['價格'] * df2_cleaned['買進股數']).groupby(df2_cleaned['券商']).sum().rename('總成交金額')
], axis=1).reset_index()

total_summary = pd.merge(df1_summary, df2_summary, on='券商', suffixes=('_1', '_2'))

total_summary['總買進股數'] = total_summary['總買進股數_1'] + total_summary['總買進股數_2']
total_summary['總成交金額'] = total_summary['總成交金額_1'] + total_summary['總成交金額_2']

total_summary['購買均價'] = (total_summary['總成交金額'] / total_summary['總買進股數']).round(1)

result = total_summary[['券商', '總買進股數', '總成交金額', '購買均價']]
