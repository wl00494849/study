    df_buy = df_buy[df_buy['買進股數'].notna() & (df_buy['買進股數'] > 0)]
    df_buy['成交金額'] = df_buy['價格'] * df_buy['買進股數']
    grouped = df_buy.groupby('券商', dropna=False).agg({'買進股數':'sum', '成交金額':'sum'}).reset_index()
    grouped['平均買進價格'] = (grouped['成交金額'] / grouped['買進股數']).round(1)
    grouped['股票代號'] = 2454
    grouped['日期'] = date
    return grouped[['股票代號','日期','券商','買進股數','成交金額','平均買進價格']]

df1_result = process_df(df1, 20250528)
df2_result = process_df(df2, 20250529)
result = pd.concat([df1_result, df2_result], ignore_index=True)
