df2_combined = pd.concat([df2_primary, df2_secondary])

df_combined = pd.concat([df1_combined, df2_combined])

df_combined['買進金額'] = df_combined['價格'] * df_combined['買進股數']

result = df_combined.groupby('券商').agg({'買進股數': 'sum', '買進金額': 'sum'}).reset_index()
result['購買均價'] = (result['買進金額'] / result['買進股數']).round(1)
result['股票代號'] = '2454'
