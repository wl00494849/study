df1_clean = df1.drop(columns=['Unnamed: 5'])
df2_clean = df2.drop(columns=['Unnamed: 5'])

df1_grouped = df1_clean.groupby('券商').agg({'買進股數': 'sum', '價格': 'mean'}).reset_index()
df1_grouped['總成交金額'] = (df1_grouped['買進股數'] * df1_grouped['價格']).round(1)

