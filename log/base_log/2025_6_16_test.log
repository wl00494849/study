# 假設所有券商對應到同一個股票代號，如 '2454' 
stock_code = '2454'

def clean_and_summarize(df):
    df = df.copy()
    df = df.dropna(subset=['券商', '價格', '買進股數'])  # 去除缺失值
    df['總買進成交金額'] = df['價格'] * df['買進股數']
    summary = df.groupby('券商').agg(
        總買進股數=('買進股數', 'sum'),
        總買進成交金額=('總買進成交金額', 'sum')
    ).reset_index()
    summary['購買均價'] = (summary['總買進成交金額'] / summary['總買進股數']).round(1)
    summary['股票代號'] = stock_code
    return summary[['券商', '總買進股數', '總買進成交金額', '購買均價', '股票代號']]

summary_df1 = clean_and_summarize(df1)
summary_df2 = clean_and_summarize(df2)

result = pd.concat([summary_df1, summary_df2]).groupby('券商').agg(
    總買進股數=('總買進股數', 'sum'),
    總買進成交金額=('總買進成交金額', 'sum'),
    購買均價=('購買均價', 'mean'),
    股票代號=('股票代號', 'first')
).reset_index()
result['購買均價'] = result['購買均價'].round(1)
```
