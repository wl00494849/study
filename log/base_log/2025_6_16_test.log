grouped = combined.groupby(['券商', combined['交易種類'].apply(lambda x: x.split('.')[0])]).sum().reset_index()
buying_summary = grouped[grouped['交易種類'] == '買進股數'].set_index('券商')
price_summary = grouped[grouped['交易種類'] == '價格'].set_index('券商')
result = buying_summary.rename(columns={'數值': '總買進股數'})
result['總成交金額'] = (price_summary['數值'] * buying_summary['數值']).round(1)
result['平均購買價格'] = (result['總成交金額'] / result['總買進股數']).round(1)
result['股票代號'] = '聯發科2454'
result = result[['股票代號', '總買進股數', '總成交金額', '平均購買價格']].reset_index()
