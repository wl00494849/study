df1.drop(columns=['Unnamed: 5'], inplace=True)
df2.drop(columns=['Unnamed: 5'], inplace=True)

df1_columns = ['序號', '券商', '價格', '買進股數', '賣出股數']
df2_columns = ['序號.1', '券商.1', '價格.1', '買進股數.1', '賣出股數.1']

df1_long = df1[df1_columns].copy()
df1_long['成交金額'] = df1_long['價格'] * df1_long['買進股數']

df1_long2 = df1[df2_columns].copy()
df1_long2.columns = df1_columns
df1_long2['成交金額'] = df1_long2['價格'] * df1_long2['買進股數']

df2_long = df2[df1_columns].copy()
df2_long['成交金額'] = df2_long['價格'] * df2_long['買進股數']

df2_long2 = df2[df2_columns].copy()
df2_long2.columns = df1_columns
df2_long2['成交金額'] = df2_long2['價格'] * df2_long2['買進股數']

df1_concat = pd.concat([df1_long, df1_long2])
df2_concat = pd.concat([df2_long, df2_long2])

total_concat = pd.concat([df1_concat, df2_concat])

result = total_concat.groupby('券商').agg({'買進股數': 'sum', '成交金額': 'sum'}).reset_index()
result['購買均價'] = (result['成交金額'] / result['買進股數']).round(1)
result['股票代號'] = 2454
