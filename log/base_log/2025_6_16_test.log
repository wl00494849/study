df1['成交金額'] = df1['價格'] * df1['買進股數']
df2['成交金額'] = df2['價格'] * df2['買進股數']

df1_grouped = df1.groupby('券商').agg({'買進股數': 'sum', '成交金額': 'sum'}).reset_index()
df2_grouped = df2.groupby('券商').agg({'買進股數': 'sum', '成交金額': 'sum'}).reset_index()

