df1_clean_1 = df1[['券商.1', '買進股數.1', '買進成交金額.1']].rename(columns={'券商.1':'券商', '買進股數.1':'買進股數', '買進成交金額.1':'買進成交金額'}).groupby('券商').sum().reset_index()

