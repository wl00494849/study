df2 = df2[~df2['區名'].isin(to_remove)]

# 3. 數據轉換為整數
# 將 df1 的數值列進行轉換，去除逗號並轉為整數
for month in df1.columns[1:]:
    df1[month] = pd.to_numeric(df1[month].str.replace(',', ''), errors='coerce').fillna(0).astype(int)

# 對 df2 的數值列也進行轉換
for month in df2.columns[1:]:
    df2[month] = pd.to_numeric(df2[month], errors='coerce').fillna(0).astype(int)

# 以上步驟完成後，df1 和 df2 應符合需求
print(df1.head())  # 查看 df1 的前三行
print(df2.head())  # 查看 df2 的前三行
```

