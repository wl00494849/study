import pandas as pd
import numpy as np

# 假設 df1 和 df2 已經存在
# df1 = pd.DataFrame(...)  # df1 的初始化
# df2 = pd.DataFrame(...)  # df2 的初始化

# 1. 新增年份欄位
# 假設年份為 2023
year = 2023
df1.insert(0, '年份', year)
df2.insert(0, '年份', year)

# 2. 刪除特定資料
# 刪除區名為 '清水', '東山', '古坑' 的行
to_remove = ['清水', '東山', '古坑']
