# 步驟 2：刪除特定區域資料
df1 = df1[~df1['區名'].isin(['清水', '東山', '古坑'])]
df2 = df2[~df2['區名'].isin(['清水', '東山', '古坑'])]

# 步驟 3：合併 DataFrame
combined_df = pd.concat([df1, df2], ignore_index=True)

# 步驟 4：數據類型轉換（如果需要）
# 將 df1 中的數字字符串轉換為浮點數，並去除逗號
