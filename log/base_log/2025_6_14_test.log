df2_avg = df2_price.groupby('券商', as_index=False)['均價'].sum()
df2_total_volume = df2_price.groupby('券商', as_index=False)['買進股數'].sum()
df2_avg = df2_avg.merge(df2_total_volume, on='券商')
df2_avg['均價'] = df2_avg['均價'] / df2_avg['買進股數']
df2_avg['日期'] = '20250529'

result = pd.merge(df1_avg[['券商', '均價', '日期']], df2_avg[['券商', '均價', '日期']], on='券商', suffixes=('_20250528', '_20250529'))
