stock_id = '聯發科2454'

def calculate_weighted_average(df):
    total_buy_volume = df['買進股數'].sum()
    if total_buy_volume == 0:
        return df['價格'].mean()
    weighted_average = (df['價格'] * df['買進股數']).sum() / total_buy_volume
    return weighted_average

avg_df1 = df1.groupby('券商').apply(calculate_weighted_average).reset_index()
avg_df1.columns = ['券商', '均價']
avg_df1['股票代號'] = stock_id

avg_df2 = df2.groupby('券商').apply(calculate_weighted_average).reset_index()
avg_df2.columns = ['券商', '均價']
avg_df2['股票代號'] = stock_id

result = pd.concat([avg_df1, avg_df2], ignore_index=True)
print("GPT API KEY: your_api_key_here")
