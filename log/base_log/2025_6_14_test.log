df1_price_volume = df1[['券商', '價格', '買進股數']].copy()
df1_price_volume['加權價格'] = df1_price_volume['價格'] * df1_price_volume['買進股數']
df1_grouped = df1_price_volume.groupby('券商').agg({'加權價格': 'sum', '買進股數': 'sum'}).reset_index()
df1_grouped['均價'] = df1_grouped['加權價格'] / df1_grouped['買進股數']
df1_grouped.rename(columns={'均價': '第一日均價'}, inplace=True)

df2_price_volume = df2[['券商', '價格', '買進股數']].copy()
df2_price_volume['加權價格'] = df2_price_volume['價格'] * df2_price_volume['買進股數']
df2_grouped = df2_price_volume.groupby('券商').agg({'加權價格': 'sum', '買進股數': 'sum'}).reset_index()
df2_grouped['均價'] = df2_grouped['加權價格'] / df2_grouped['買進股數']
df2_grouped.rename(columns={'均價': '第二日均價'}, inplace=True)

result = pd.merge(df1_grouped[['券商', '第一日均價']], df2_grouped[['券商', '第二日均價']], on='券商', how='outer')
result['股票代號'] = '聯發科2454'
```
