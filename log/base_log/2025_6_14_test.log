df1_avg = df1_price.groupby('券商', as_index=False)['均價'].sum()
df1_total_volume = df1_price.groupby('券商', as_index=False)['買進股數'].sum()
df1_avg = df1_avg.merge(df1_total_volume, on='券商')
df1_avg['均價'] = df1_avg['均價'] / df1_avg['買進股數']
df1_avg['日期'] = '20250528'

df2_price = df2[['券商', '價格', '買進股數']].copy()
