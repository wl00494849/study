df1['成交金額'] = df1['價格'] * df1['買進股數']
df2['成交金額'] = df2['價格'] * df2['買進股數']
df1_grouped = df1.groupby('券商').agg({'成交金額': 'sum', '買進股數': 'sum'})
df2_grouped = df2.groupby('券商').agg({'成交金額': 'sum', '買進股數': 'sum'})
result = pd.concat([df1_grouped, df2_grouped], axis=1)
result.columns = ['成交金額_df1', '買進股數_df1', '成交金額_df2', '買進股數_df2']
result['總成交金額'] = result[['成交金額_df1', '成交金額_df2']].sum(axis=1)
result['總買進股數'] = result[['買進股數_df1', '買進股數_df2']].sum(axis=1)
result['均價'] = result['總成交金額'] / result['總買進股數']
result.reset_index(inplace=True)
result['股票代號'] = df1['券商'].unique()
```
