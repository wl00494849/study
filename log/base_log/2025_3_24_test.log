df1.iloc[:, 1:] = df1.iloc[:, 1:].replace({',': ''}, regex=True).astype(float)
df2 = df2.fillna(0)
result = df1.merge(df2, on='區名', suffixes=('_112', '_113'))
avg_cols = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']
result[avg_cols] = ((result[[col for col in result.columns if col.endswith('_112')]] + result[[col for col in result.columns if col.endswith('_113')]]) / 2).round().astype(int)
result = result[['區名'] + avg_cols]

