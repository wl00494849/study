```python
import pandas as pd

# 假設 df1 和 df2 是已存在的 DataFrame
# 創建行業標記
df1['行業'] = '飼料製造業'
df2['行業'] = '飼料零售業'

# 合併兩個 DataFrame
combined_df = pd.concat([df1, df2], ignore_index=True)

# 過濾出公司地址在新北市的公司
new_taipei_df = combined_df[combined_df['公司地址'].str.contains('新北市')]

# 處理重複公司
new_taipei_df['重複標記'] = new_taipei_df.duplicated(subset=['統一編號'], keep=False)

# 根據重複標記更新行業欄
new_taipei_df['行業'] = new_taipei_df.apply(
    lambda x: '重複' if x['重複標記'] else x['行業'], 
    axis=1
)

# 去除重複公司
final_df = new_taipei_df.drop_duplicates(subset=['統一編號'])

# 最終顯示
final_df = final_df[['統一編號', '公司名稱', '負責人', '公司地址', '資本總額', 
                      '實收資本額', '在境內營運資金', '公司狀態', '產製日期', '行業']]

print(final_df)
```

