```python
import pandas as pd

# 假設 df1 和 df2 已經被創建並載入好

# 1. 新增行業標記
df1['行業標記'] = '飼料製造業'
df2['行業標記'] = '飼料零售業'

# 2. 合併數據
df_combined = pd.concat([df1, df2], ignore_index=True)

# 3. 過濾出地址在新北市的公司
df_filtered = df_combined[df_combined['公司地址'].str.contains('新北市')]

# 4. 處理重複公司
df_filtered['重複標記'] = df_filtered.duplicated(subset=['統一編號'], keep=False)

# 5. 標記重複行業
df_filtered.loc[df_filtered['重複標記'], '行業標記'] += ' (重複)'

# 6. 去除重複公司，只保留一筆資料
df_result = df_filtered.drop_duplicates(subset=['統一編號'])

# 最後的結果
print(df_result)
```

